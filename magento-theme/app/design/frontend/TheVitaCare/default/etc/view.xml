<?xml version="1.0"?>
<view xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Config/etc/view.xsd">
    <media>
        <images module="Magento_Catalog">
            <image id="category_page_grid" type="small_image"><width>400</width><height>400</height></image>
            <image id="category_page_list" type="small_image"><width>400</width><height>400</height></image>
            <image id="product_page_image_medium" type="image"><width>800</width><height>800</height></image>
            <image id="product_page_image_large" type="image"><width>1200</width><height>1200</height></image>
            <image id="related_products_list" type="small_image"><width>300</width><height>300</height></image>
            <image id="upsell_products_list" type="small_image"><width>300</width><height>300</height></image>
            <image id="cart_page_product_thumbnail" type="thumbnail"><width>120</width><height>120</height></image>
            <image id="mini_cart_product_thumbnail" type="thumbnail"><width>90</width><height>90</height></image>
        </images>
    </media>
    <vars module="Magento_Catalog">
        <var name="gallery">
            <var name="nav">thumbs</var>
            <var name="allowfullscreen">true</var>
            <var name="navdir">horizontal</var>
        </var>
    </vars>
</view>
